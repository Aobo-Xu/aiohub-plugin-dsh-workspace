{
  "id": "dsh-coding-workspace",
  "name": "Coding工作站",
  "version": "0.1.0",
  "description": "A managed DSH coding execution domain for AIO Hub.",
  "author": "AIO Hub",
  "host": {
    "appVersion": ">=0.7.0-alpha.4",
    "apiVersion": 3,
    "platforms": [
      "win32-x64"
    ]
  },
  "type": "sidecar",
  "sidecar": {
    "executable": {
      "win32-x64": "bin/win32-x64/aio-dsh-supervisor.exe"
    },
    "resident": true,
    "startupMethod": "initialize",
    "startupParams": {}
  },
  "methods": [
    {
      "name": "initialize",
      "description": "Negotiate and initialize the DSH execution domain.",
      "parameters": [
        { "name": "hostApiVersion", "type": "number", "required": true },
        { "name": "platform", "type": "string", "required": true },
        { "name": "pluginDataDir", "type": "string", "required": true },
        { "name": "prewarm", "type": "boolean", "required": true }
      ],
      "returnType": "Promise<object>"
    },
    {
      "name": "acquireSession",
      "description": "Acquire a controller or observer lease for a DSH session.",
      "parameters": [
        { "name": "domainGenerationId", "type": "string", "required": true },
        { "name": "contractHash", "type": "string", "required": true },
        { "name": "sessionId", "type": "string", "required": true },
        { "name": "viewId", "type": "string", "required": true },
        { "name": "requestedMode", "type": "string", "required": true }
      ],
      "returnType": "Promise<object>"
    },
    {
      "name": "transferController",
      "description": "Transfer a DSH session controller lease to another view.",
      "parameters": [
        { "name": "domainGenerationId", "type": "string", "required": true },
        { "name": "contractHash", "type": "string", "required": true },
        { "name": "sessionId", "type": "string", "required": true },
        { "name": "leaseId", "type": "string", "required": true },
        { "name": "mode", "type": "string", "required": true },
        { "name": "targetViewId", "type": "string", "required": true }
      ],
      "returnType": "Promise<object>"
    },
    {
      "name": "command",
      "description": "Execute a DSH runtime command with a valid controller lease.",
      "parameters": [
        { "name": "lease", "type": "object", "required": false },
        { "name": "command", "type": "object", "required": true }
      ],
      "returnType": "Promise<object>"
    },
    {
      "name": "snapshot",
      "description": "Read a durable DSH session snapshot.",
      "parameters": [
        { "name": "sessionId", "type": "string", "required": true },
        { "name": "cursor", "type": "string", "required": false }
      ],
      "returnType": "Promise<object>"
    },
    {
      "name": "shutdown",
      "description": "Gracefully stop the DSH execution domain for the supplied lifecycle reason.",
      "parameters": [
        { "name": "reason", "type": "string", "required": true }
      ],
      "returnType": "Promise<void>"
    }
  ],
  "settingsSchema": {
    "version": "1.0",
    "properties": {
      "prewarm": {
        "type": "boolean",
        "default": false,
        "label": "Prewarm runtime"
      },
      "idleGraceSeconds": {
        "type": "number",
        "default": 600,
        "label": "Idle grace period"
      }
    }
  },
  "contributions": [
    {
      "type": "capability",
      "id": "execution-domain:dsh",
      "version": 1,
      "stability": "stable"
    }
  ]
}
