{
  "name": "@aiohub/dsh-coding-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": "22.19.0"
  },
  "workspaces": [
    "packages/*",
    "ui"
  ],
  "scripts": {
    "check": "bun run check:types && bun run check:generated-types && bun run check:generated && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "check:types": "tsc --project tsconfig.json",
    "check:generated-types": "tsc --project tsconfig.generated.json",
    "test": "vitest run && cargo test --workspace",
    "build": "bun run build:protocol && bun run build:host && bun scripts/verify-built-runtime.ts",
    "build:host": "bun scripts/build-host.ts",
    "build:protocol": "bun run generate:protocol && cargo build -p aio-dsh-protocol --release",
    "generate:protocol": "cargo run -p aio-dsh-protocol --bin generate --",
    "check:generated": "cargo run -p aio-dsh-protocol --bin generate -- --check",
    "check:ui": "vue-tsc --project ui/tsconfig.json",
    "test:ui": "vitest run ui/tests",
    "build:ui": "vite build ui",
    "runtime:resolve-current": "node --experimental-strip-types scripts/runtime/resolve-runtime.ts",
    "package:platform": "bun run build:host && bun run build:ui && node --experimental-strip-types scripts/package-platform.ts --support supported",
    "runtime:acquire-wheel": "node --experimental-strip-types scripts/runtime/acquire-official-wheel.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-query": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage": "0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-terminal": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-rc.1",
    "@types/bun": "1.3.11",
    "typescript": "5.6.2",
    "vitest": "^4.1.8"
  }
}
