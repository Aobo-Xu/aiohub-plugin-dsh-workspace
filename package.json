{
  "name": "@aiohub/dsh-coding-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": "22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run check:types && bun run check:generated-types && bun run check:generated && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "check:types": "tsc --project tsconfig.json",
    "check:generated-types": "tsc --project tsconfig.generated.json",
    "test": "vitest run && cargo test --workspace",
    "build": "bun run build:protocol && bun scripts/verify-built-runtime.ts",
    "build:protocol": "bun run generate:protocol && cargo build -p aio-dsh-protocol --release",
    "generate:protocol": "cargo run -p aio-dsh-protocol --bin generate --",
    "check:generated": "cargo run -p aio-dsh-protocol --bin generate -- --check",
    "runtime:resolve-current": "bun -e \"console.error('DSH_RUNTIME_TASK_5_PENDING'); process.exit(1)\"",
    "package:platform": "bun -e \"console.error('DSH_PLATFORM_PACKAGE_TASK_14_PENDING'); process.exit(1)\"",
    "build:dsh-source": "bun -e \"console.error('DSH_RUNTIME_TASK_5_PENDING: pnpm 11.7.0, Python 3.10'); process.exit(1)\""
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "5.6.2",
    "vitest": "^4.1.8"
  }
}
