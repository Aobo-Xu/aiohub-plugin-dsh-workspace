{
  "name": "@aiohub/dsh-coding-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": "22.19.0"
  },
  "scripts": {
    "check": "bun run check:generated && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "vitest run && cargo test --workspace",
    "build": "bun run generate:protocol && cargo build --workspace --release",
    "generate:protocol": "bun scripts/generate-protocol.ts",
    "check:generated": "bun scripts/check-generated.ts",
    "runtime:resolve-current": "bun scripts/runtime/resolve-runtime.ts",
    "package:platform": "bun scripts/package-platform.ts",
    "build:dsh-source": "bun scripts/runtime/build-from-source.ts --pnpm 11.7.0 --python 3.10"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}
