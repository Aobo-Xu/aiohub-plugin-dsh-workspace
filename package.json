{
  "name": "@aiohub/dsh-coding-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": "22.19.0"
  },
  "scripts": {
    "check": "bun run check:generated && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "vitest run && cargo test --workspace",
    "build": "bun run generate:protocol && cargo build --workspace --release",
    "generate:protocol": "bun -e \"console.error('DSH_PROTOCOL_TASK_3_PENDING'); process.exit(1)\"",
    "check:generated": "bun -e \"console.error('DSH_PROTOCOL_TASK_3_PENDING'); process.exit(1)\"",
    "runtime:resolve-current": "bun -e \"console.error('DSH_RUNTIME_TASK_5_PENDING'); process.exit(1)\"",
    "package:platform": "bun -e \"console.error('DSH_PLATFORM_PACKAGE_TASK_14_PENDING'); process.exit(1)\"",
    "build:dsh-source": "bun -e \"console.error('DSH_RUNTIME_TASK_5_PENDING: pnpm 11.7.0, Python 3.10'); process.exit(1)\""
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}
